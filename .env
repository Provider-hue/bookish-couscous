# rndf backend environment (local dev).
# Real deployments read the process env instead - Render gets these from
# render.yaml, so nothing secret lives in this file. `.env` is gitignored.

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Optional gate on POST /detect (Bearer / X-API-Key). Empty = endpoint open.
# On Render this is auto-generated (render.yaml `generateValue: true`); copy the
# value into the Vercel env as DEMO_API_KEY so the frontend can send it.
API_KEY=bear_Ashu_Ft2ook5-_FxM2EkokVUkmx2CUeewTxtP

# CORS: comma-separated origins, or * for any (demo default).
ALLOWED_ORIGINS=*

# Upload cap in MB (matches the sahu65 default).
MAX_UPLOAD_MB=10
