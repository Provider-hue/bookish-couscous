# Copy to .env and fill in. .env itself is gitignored - never commit real keys.
# Values here are read by server.py; real process env always wins, so Render/Vercel
# inject their own and this file only fills the gaps for local runs.

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Optional gate on POST /detect (Bearer / X-API-Key). Empty = endpoint open.
API_KEY=

# CORS: comma-separated origins, or * for any (demo default).
ALLOWED_ORIGINS=*

# Upload cap in MB (matches the sahu65 default).
MAX_UPLOAD_MB=10

# --- Groq narrator (POST /detect) ---------------------------------------------
# The narrator explains the verdict, it never decides one. Without a key the scan
# still returns: explanation falls back to a factual template and intent is null.

# From https://console.groq.com/keys
GROQ_API_KEY=

# Swap models without touching code. Current ids:
# https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Narrator instructions. A double-quoted value may span as many lines as you like -
# that is the easiest way to edit it. Leave it empty to use the built-in default
# in server.py (DEFAULT_SYSTEM_PROMPT).
SYSTEM_PROMPT=

# Per-request Groq timeout, seconds. Retries and HTTP error handling come from
# sahu65's own provider object.
NARRATOR_TIMEOUT_S=20